  "info": {
    "_postman_id": "365ad13e-ba93-4cbe-9b67-8f7e25da0aec",
    "name": "Nine Fives Programmable REST Attenuator Firmware API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "JSON REST API served on port 80 by the Nine Fives POE-ATTEN-6G programmable RF attenuator for programmatic control and monitoring. Faithfully transcribed from the published device reference manual; the device also exposes SCPI over raw TCP (port 5025) and HiSLIP (port 4880). No authentication is required — the API is served directly by the device over the local network (Ethernet or USB-C).\n\nContact Support:\n Name: Nine Fives",
      "type": "text/plain"
    }
  }
