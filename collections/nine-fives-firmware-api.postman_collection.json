        {
          "id": "a6c007f8-9864-4df1-bca3-37def5853ea2",
          "name": "Upload and install a firmware bundle",
          "request": {
            "name": "Upload and install a firmware bundle",
            "description": {
              "content": "Upload a .raucb firmware bundle (max 256 MiB) for installation. Uses multipart/form-data. The mode query parameter is empty (default) for single slot or \"full\" for both slots. Installation runs asynchronously; poll GET /api/firmware/status for progress.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "firmware",
                "update"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "<string>",
                  "description": "Empty (default) for single slot, \"full\" for both slots"
                }
              ],
              "variable": [
                {
                  "description": "The IP address of the attenuator device on the local network",
                  "type": "any",
                  "value": "{{deviceIp}}",
                  "key": "deviceIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "firmware",
                  "type": "file",
                  "description": "The .raucb file (max 256 MiB)"
                }
              ]
            }
          },
          "response": [
            {
              "id": "578255a0-1e8f-45af-8011-566fbeb3ba21",
              "name": "Accepted — installation started",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "firmware",
                    "update"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "mode",
                      "value": "<string>"
                    }
                  ],
                  "variable": [
                    {
                      "description": "The IP address of the attenuator device on the local network",
                      "type": "any",
                      "value": "{{deviceIp}}",
                      "key": "deviceIp"
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "The .raucb file (max 256 MiB)",
                        "type": "text/plain"
                      },
                      "key": "firmware",
                      "value": "<binary>",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "Accepted",
              "code": 202,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"string\",\n  \"message\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
