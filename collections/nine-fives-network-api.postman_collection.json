          "name": "Update network configuration",
          "request": {
            "name": "Update network configuration",
            "description": {
              "content": "Updates network configuration and applies it immediately. Ethernet, USB-C, or both interfaces may be updated in a single request; only include fields to change. Changing network settings while connected may result in loss of connectivity.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "network",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The IP address of the attenuator device on the local network",
                  "type": "any",
                  "value": "{{deviceIp}}",
                  "key": "deviceIp"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ethernet\": {\n    \"mode\": \"<string>\",\n    \"ip_address\": \"<string>\",\n    \"netmask\": \"<string>\",\n    \"gateway\": \"<string>\",\n    \"dhcp_fallback_timeout\": \"<integer>\",\n    \"dhcp_server\": {\n      \"range_start\": \"<string>\",\n      \"range_end\": \"<string>\",\n      \"lease_time\": \"<string>\"\n    }\n  },\n  \"usb_gadget\": {\n    \"mode\": \"<string>\",\n    \"ip_address\": \"<string>\",\n    \"netmask\": \"<string>\",\n    \"enabled\": \"<boolean>\",\n    \"dhcp_server\": {\n      \"range_start\": \"<string>\",\n      \"range_end\": \"<string>\",\n      \"lease_time\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
